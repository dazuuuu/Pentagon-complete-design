# Pentagon Quest — Apache Configuration
Options -Indexes

# Charset
AddDefaultCharset UTF-8

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml
</IfModule>

# Cache headers
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 week"
  ExpiresByType image/png "access plus 1 month"
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# API routing
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^api/(.*)$ api/index.php [QSA,L]
  RewriteRule ^handlers/(.*)$ handlers/index.php [QSA,L]
</IfModule>

# ── Clean URLs ──────────────────────────────────────────────
# Internally maps extensionless paths to the real .php files, so the
# address bar reads e.g. /tours or /tours/12 instead of tours.php or
# tour-details.php?id=12. All internal links already point at these
# clean paths. Existing *.php URLs still work (not redirected) —
# see the note in README about adding a 301 canonicalization pass
# before this site is submitted for indexing.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Detail pages: /tours/12 -> tour-details.php?id=12
  RewriteRule ^tours/([0-9]+)/?$ tour-details.php?id=$1 [L,QSA]
  RewriteRule ^destinations/([0-9]+)/?$ destination-details.php?id=$1 [L,QSA]
  RewriteRule ^blog/([0-9]+)/?$ blog-details.php?id=$1 [L,QSA]
  RewriteRule ^experiences/([0-9]+)/?$ experience-details.php?id=$1 [L,QSA]

  # sitemap.xml -> sitemap.php (dynamic, includes tours/destinations/blog)
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # Top-level pages: /tours -> tours.php
  RewriteRule ^about/?$ about.php [L,QSA]
  RewriteRule ^services/?$ services.php [L,QSA]
  RewriteRule ^tours/?$ tours.php [L,QSA]
  RewriteRule ^destinations/?$ destinations.php [L,QSA]
  RewriteRule ^mice/?$ mice.php [L,QSA]
  RewriteRule ^gallery/?$ gallery.php [L,QSA]
  RewriteRule ^blog/?$ blog.php [L,QSA]
  RewriteRule ^contact/?$ contact.php [L,QSA]
  RewriteRule ^request-quote/?$ request-quote.php [L,QSA]
</IfModule>

# Protect apps directory from direct web access
<IfModule mod_rewrite.c>
  RewriteRule ^apps/ - [F,L]
</IfModule>

# Redirect www to non-www (update domain as needed)
# RewriteEngine On
# RewriteCond %{HTTP_HOST} ^www\.pentagonquest\.com [NC]
# RewriteRule ^(.*)$ https://pentagonquest.com/$1 [R=301,L]
