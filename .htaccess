# Pentagon Quest — repository root
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Keep backend and Composer files off the public web
  RewriteRule ^apps/ - [F,L]
  RewriteRule ^vendor/ - [F,L]
  RewriteRule ^\.env - [F,L]
  RewriteRule ^(composer\.(json|lock)|README\.md|router\.php)$ - [F,L]

  # Serve the site from publics/ while keeping URLs at the domain root
  RewriteRule ^$ publics/ [L]
  RewriteCond %{REQUEST_URI} !^/publics/
  RewriteRule ^(.*)$ publics/$1 [L]
</IfModule>
